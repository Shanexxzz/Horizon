{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0.5,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-python",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "anthropic-sdk-python",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "ai-tools"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100,
      "category": "ai-news"
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "James Clear",
        "url": "https://jamesclear.com/feed",
        "enabled": true,
        "category": "personal-growth"
      },
      {
        "name": "Farnam Street",
        "url": "https://fs.blog/feed/",
        "enabled": true,
        "category": "mental-models"
      },
      {
        "name": "Ness Labs",
        "url": "https://nesslabs.com/feed",
        "enabled": true,
        "category": "knowledge-work"
      },
      {
        "name": "Buffer",
        "url": "https://buffer.com/resources/rss/",
        "enabled": true,
        "category": "content-growth"
      },
      {
        "name": "Product Hunt",
        "url": "https://www.producthunt.com/feed",
        "enabled": true,
        "category": "creator-tools"
      },
      {
        "name": "HubSpot Marketing",
        "url": "https://blog.hubspot.com/marketing/rss.xml",
        "enabled": true,
        "category": "content-growth"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "productivity",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "productivity"
        },
        {
          "subreddit": "ChatGPT",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 100,
          "category": "ai-tools"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": true,
      "mode": "apify",
      "users": [
        "JamesClear",
        "naval",
        "SahilBloom",
        "AlexHormozi",
        "AliAbdaal",
        "dickiebush",
        "Nicolascole77",
        "karpathy",
        "swyx",
        "OpenAI"
      ],
      "fetch_limit": 100,
      "run_every_days": 2,
      "category": "creator-signals",
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 0,
      "reply_min_likes": 5
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All"
      ],
      "keywords": [
        "ai",
        "llm",
        "agent",
        "creator",
        "productivity",
        "knowledge"
      ],
      "min_stars": 20,
      "max_items": 20,
      "category": "github-trending"
    },
    "gdelt": {
      "enabled": false,
      "query": "creator economy OR personal growth OR productivity OR AI tools",
      "mode": "ArtList",
      "max_records": 50,
      "timespan": "24h",
      "language": "english",
      "country": null,
      "category": "growth-news"
    },
    "google_news": {
      "enabled": false,
      "query": "(intitle:\"个人成长\" OR intitle:\"知识管理\" OR intitle:\"效率工具\" OR intitle:\"内容创作\" OR intitle:\"创作者经济\" OR intitle:\"AI工具\") -体育 -娱乐 -足球 -篮球 -F1",
      "language": "zh-CN",
      "country": "CN",
      "ceid": "CN:zh-Hans",
      "max_results": 30,
      "category": "growth-news"
    }
  },
  "filtering": {
    "ai_score_threshold": 6.5,
    "time_window_hours": 24,
    "max_items": 20,
    "category_groups": {
      "growth": {
        "name": "成长与认知",
        "limit": 6,
        "categories": [
          "personal-growth",
          "mental-models",
          "knowledge-work",
          "productivity"
        ],
        "score_threshold": 5.5
      },
      "creator": {
        "name": "内容与增长",
        "limit": 6,
        "categories": [
          "content-growth",
          "creator-tools",
          "creator-signals",
          "growth-news"
        ],
        "score_threshold": 5.5
      },
      "ai": {
        "name": "AI与工具",
        "limit": 8,
        "categories": [
          "ai-news",
          "ai-tools",
          "github-trending"
        ],
        "score_threshold": 6.5
      }
    },
    "default_group": "other",
    "default_group_limit": 3
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": null,
    "headers": ""
  }
}
